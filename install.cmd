@echo off
set "UNIFIED_INSTALL_SOURCE=%~dp0voice-diary-unified"
powershell.exe -NoProfile -STA -Command "$ErrorActionPreference='Stop'; try { Add-Type -AssemblyName System.Windows.Forms; if(!(Test-Path -LiteralPath (Join-Path $env:UNIFIED_INSTALL_SOURCE 'manifest.json'))){throw 'Unzip the complete package first.'}; $dialog=New-Object System.Windows.Forms.FolderBrowserDialog; $dialog.Description='Select the active Obsidian vault root. Close Obsidian before installing.'; if($dialog.ShowDialog() -ne 'OK'){exit}; $vault=$dialog.SelectedPath; if(!(Test-Path -LiteralPath (Join-Path $vault '.obsidian'))){throw 'The selected folder does not contain .obsidian. For a custom config folder, install manually.'}; $target=Join-Path $vault '.obsidian\plugins\voice-diary-unified'; if(Test-Path -LiteralPath $target){$backup=Join-Path $vault ('.obsidian\voice-diary-unified-backups\'+(Get-Date -Format yyyyMMddHHmmssfff)); New-Item -ItemType Directory -Path $backup -Force | Out-Null; Copy-Item -LiteralPath $target -Destination (Join-Path $backup 'voice-diary-unified') -Recurse}; New-Item -ItemType Directory -Path $target -Force | Out-Null; Get-ChildItem -LiteralPath $env:UNIFIED_INSTALL_SOURCE | Copy-Item -Destination $target -Recurse -Force; [System.Windows.Forms.MessageBox]::Show('Plugin copied. Restart Obsidian and enable Voice Diary Unified. Set your recording and note folders, prepare SenseVoice, then enable automatic processing for a short test. Existing notes and settings were preserved.','Voice Diary Unified') | Out-Null } catch { [System.Windows.Forms.MessageBox]::Show($_.Exception.Message,'Installation failed') | Out-Null; exit 1 }"
pause
